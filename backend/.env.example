# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. See config.py for what each one does and
# which are required vs optional.

# --- required, no fallback — the process refuses to start without these ---
OG_DB_PASSWORD=changeme
OG_SECRET_KEY=changeme

# --- optional — shown here with the defaults config.py already uses ---
# OG_DB_NAME=subscription
# OG_DB_USER=postgres
# OG_DB_HOST=localhost
# OG_DB_PORT=5433
# OG_TOKEN_TTL_HOURS=12
# OG_HOST=127.0.0.1
# OG_PORT=5000
# OG_DEFAULT_TENANT=MCM Group
# OG_PUBLIC_BASE_URL=http://127.0.0.1:5000
