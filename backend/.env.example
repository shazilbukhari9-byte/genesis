# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. See config.py for what each one does and
# which are required vs optional.

# --- required, no fallback — the process refuses to start without these ---
OG_DB_PASSWORD=changeme
OG_SECRET_KEY=changeme

# --- optional — shown here with the defaults config.py already uses ---
# OG_DB_NAME=subscription
# OG_DB_USER=postgres
# OG_DB_HOST=localhost
# OG_DB_PORT=5433
# OG_TOKEN_TTL_HOURS=12
# OG_HOST=127.0.0.1
# OG_PORT=5000
# OG_DEFAULT_TENANT=MCM Group
# OG_PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- Salesforce integration (Admin > Integrations, Phase 1), optional —
# the app runs fine with none of these set; only Connect/Test Connection
# on the Salesforce CTI row and the CRM_Lookup_Customer data action need
# them. See SALESFORCE_INTEGRATION.md for how to create a Salesforce
# Connected App and where to find these values.
# OG_SALESFORCE_CLIENT_ID=your-connected-app-consumer-key
# OG_SALESFORCE_CLIENT_SECRET=your-connected-app-consumer-secret
# OG_SALESFORCE_LOGIN_BASE_URL=https://login.salesforce.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable once set — rotating it makes every already-stored
# Salesforce token undecryptable (the connection just needs reconnecting).
# OG_INTEGRATION_ENCRYPTION_KEY=generate-a-fernet-key-see-comment-above
