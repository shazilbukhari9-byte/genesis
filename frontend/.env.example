# Copy this file to .env and adjust for your environment. .env is
# gitignored — never commit a real production URL here (or anywhere else
# in source); Vite only exposes variables prefixed VITE_ to the browser
# bundle (see vite.config.ts / @lovable.dev/vite-tanstack-config), and
# every VITE_ variable ends up readable in the shipped JS, so treat this
# file as public configuration, not secrets.

# Base URL of the Genesis backend API this frontend talks to.
# Local dev (matches backend/.env's default OG_HOST/OG_PORT):
VITE_API_BASE=http://127.0.0.1:5000
# Production: set this in your hosting platform's environment variables
# (Vercel/Render/etc project settings) to the deployed backend's URL —
# never hardcode it in source. Example:
# VITE_API_BASE=https://genesis-api.example.com
#
# If this is left unset in a hosting platform's env vars, the app falls
# back to this project's real Render backend (see frontend/src/features/
# shared/backend.ts and frontend/src/routes/index.tsx) rather than to
# localhost, so a missing variable can no longer break the app for every
# visitor — but set it explicitly for any deployment that should use a
# different backend (staging, a fork, etc).
